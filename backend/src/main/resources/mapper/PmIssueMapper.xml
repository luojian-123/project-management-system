<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pms.mapper.PmIssueMapper">
  <resultMap id="BaseResultMap" type="com.pms.entity.PmIssue">
    <id column="id" property="id"/>
    <result column="project_id" property="projectId"/>
    <result column="task_id" property="taskId"/>
    <result column="issue_code" property="issueCode"/>
    <result column="title" property="title"/>
    <result column="description" property="description"/>
    <result column="severity" property="severity"/>
    <result column="status" property="status"/>
    <result column="assignee_id" property="assigneeId"/>
    <result column="found_date" property="foundDate"/>
    <result column="resolved_date" property="resolvedDate"/>
    <result column="created_by" property="createdBy"/>
    <result column="created_at" property="createdAt"/>
    <result column="updated_at" property="updatedAt"/>
  </resultMap>
  <sql id="wherePage">
    <where>
      <if test="projectId != null">AND project_id = #{projectId}</if>
      <if test="status != null and status != ''">AND status = #{status}</if>
    </where>
  </sql>
  <select id="selectPage" resultMap="BaseResultMap">
    SELECT * FROM pm_issue <include refid="wherePage"/> ORDER BY id DESC LIMIT #{offset}, #{limit}
  </select>
  <select id="countPage" resultType="long">SELECT COUNT(*) FROM pm_issue <include refid="wherePage"/></select>
  <select id="selectById" resultMap="BaseResultMap">SELECT * FROM pm_issue WHERE id = #{id}</select>
  <select id="selectMaxIssueCode" resultType="string">SELECT MAX(issue_code) FROM pm_issue</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO pm_issue (project_id, task_id, issue_code, title, description, severity, status, assignee_id, found_date, resolved_date, created_by)
    VALUES (#{projectId}, #{taskId}, #{issueCode}, #{title}, #{description}, #{severity}, #{status}, #{assigneeId}, #{foundDate}, #{resolvedDate}, #{createdBy})
  </insert>
  <update id="updateById">
    UPDATE pm_issue SET project_id=#{projectId}, task_id=#{taskId}, issue_code=#{issueCode}, title=#{title}, description=#{description}, severity=#{severity}, status=#{status}, assignee_id=#{assigneeId}, found_date=#{foundDate}, resolved_date=#{resolvedDate} WHERE id = #{id}
  </update>
  <delete id="deleteById">DELETE FROM pm_issue WHERE id = #{id}</delete>
</mapper>
